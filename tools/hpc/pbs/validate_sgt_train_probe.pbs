#!/bin/bash
# Ported from PHAL (scripts/pbs/validate_train_probe.pbs) at 96263b6; MIT License, see NOTICE.
#
# GH200 validation of the GMD_SGT training image (containers/Dockerfile.sgt-train)
# as a SIF: CUDA platform gate and a random tiny GMD_SGT model on CPU and GPU.
# NOT RUN YET: written without access to Miyabi; no job has been submitted.
#
# Submit through tools/hpc/pbs/submit.sh (queue/group from GMD_AL_PBS_QUEUE /
# GMD_AL_PBS_GROUP), or directly:
#   qsub -q debug-g -W group_list=<group> \
#        -v GMD_AL_SGT_TRAIN_IMAGE=/abs/path/sgt-train.sif,GMD_AL_PBS_GROUP=<group> \
#        tools/hpc/pbs/validate_sgt_train_probe.pbs
# The queue below is only a default; `qsub -q` overrides it. No group is
# hard-coded: pass it with `-W group_list=`.
#
#PBS -q debug-g
#PBS -l select=1
#PBS -l walltime=00:15:00
#PBS -N gmd-al-sgt-train-probe
#PBS -j oe

set -euo pipefail
cd "${PBS_O_WORKDIR:?PBS_O_WORKDIR is not set; submit with qsub}"

GMD_AL_APPTAINER_MODULE=${GMD_AL_APPTAINER_MODULE:-apptainer/1.3.5}
module purge
module load "${GMD_AL_APPTAINER_MODULE}"

: "${GMD_AL_SGT_TRAIN_IMAGE:?GMD_AL_SGT_TRAIN_IMAGE is not set}"
IMAGE=${GMD_AL_SGT_TRAIN_IMAGE}
if [[ ! -f "${IMAGE}" ]]; then
    echo "ERROR: SIF image not found: ${IMAGE}" >&2
    exit 2
fi
# Fix for PHAL F-32: the digest is computed from the image this job runs, never
# copied from a manifest.
SIF_SHA256=$(sha256sum "${IMAGE}" | awk '{print $1}')

RUNTIME_HOST_DIR=${GMD_AL_RUNTIME_DIR:-"${PBS_O_WORKDIR}/runtime"}
LOG_DIR="${RUNTIME_HOST_DIR}/logs/sgt-train-probe"
CONTAINER_LOG_DIR="/runtime/logs/sgt-train-probe"
JOB_TMP_ROOT="${TMPDIR:-/tmp/${USER}/${PBS_JOBID}}"
export APPTAINER_TMPDIR="${JOB_TMP_ROOT}/gmd-al-sgt-train-probe"
export APPTAINERENV_GMD_AL_REQUIRE_CUDA=1
mkdir -p "${LOG_DIR}" "${APPTAINER_TMPDIR}"
trap 'rm -rf "${APPTAINER_TMPDIR}"' EXIT

ENV_LOG="${LOG_DIR}/environment-${PBS_JOBID}.log"
SUMMARY="${LOG_DIR}/summary-${PBS_JOBID}.json"
START_TIME=$(date --iso-8601=seconds)

# HPC-X workaround from PHAL's diagnose_md_probe_hpcx.pbs: the NGC image's UCC
# needs the matching UCX ahead of the host-injected one, and OPAL_PREFIX from
# the host breaks the container's OpenMPI.
HPCX_PREFIX='unset OPAL_PREFIX; export LD_LIBRARY_PATH="/opt/hpcx/ucx/lib:/opt/hpcx/ucc/lib:${LD_LIBRARY_PATH:-}"; exec "$@"'

container_run() {
    apptainer exec --cleanenv --nv --bind "${RUNTIME_HOST_DIR}:/runtime" \
        "${IMAGE}" sh -lc "${HPCX_PREFIX}" sh "$@"
}

json_escape() {
    printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr -d '\n'
}

STAGES=""
OVERALL=passed
# run_stage NAME LOGFILE COMMAND... : never aborts the job, records the status.
run_stage() {
    local name=$1 log=$2
    shift 2
    echo "=== ${name} ==="
    set +e
    "$@" > "${log}" 2>&1
    local rc=$?
    set -e
    cat "${log}"
    local status=passed
    if (( rc != 0 )); then
        status=failed
        OVERALL=failed
    fi
    STAGES="${STAGES}${STAGES:+,}\"${name}\":{\"exit_status\":${rc},\"status\":\"${status}\",\"log\":\"$(json_escape "${log}")\"}"
}

{
    echo "job_id=${PBS_JOBID}"
    echo "hostname=$(hostname)"
    echo "queue=${PBS_QUEUE:-unknown}"
    echo "group=${GMD_AL_PBS_GROUP:-unknown}"
    echo "workdir=${PBS_O_WORKDIR}"
    echo "image=${IMAGE}"
    echo "sif_sha256=${SIF_SHA256}"
    echo "apptainer=$(apptainer version)"
    echo "start_time=${START_TIME}"
} | tee "${ENV_LOG}"

run_stage platform "${LOG_DIR}/platform-${PBS_JOBID}.json.log" \
    container_run python /opt/gmd_al/containers/scripts/validate_platform.py
run_stage sgt_stack "${LOG_DIR}/sgt-stack-${PBS_JOBID}.json.log" \
    container_run python /opt/gmd_al/containers/scripts/validate_sgt_stack.py \
        --output "${CONTAINER_LOG_DIR}/sgt-stack-${PBS_JOBID}.json"

END_TIME=$(date --iso-8601=seconds)
EXIT_STATUS=0
[[ "${OVERALL}" == passed ]] || EXIT_STATUS=1
cat > "${SUMMARY}" <<EOF
{"probe":"sgt-train","job_id":"$(json_escape "${PBS_JOBID}")","node":"$(json_escape "$(hostname)")","queue":"$(json_escape "${PBS_QUEUE:-unknown}")","group":"$(json_escape "${GMD_AL_PBS_GROUP:-unknown}")","image":"$(json_escape "${IMAGE}")","sif_sha256":"${SIF_SHA256}","apptainer":"$(json_escape "$(apptainer version)")","start_time":"${START_TIME}","end_time":"${END_TIME}","stages":{${STAGES}},"status":"${OVERALL}","exit_status":${EXIT_STATUS}}
EOF
echo "summary=${SUMMARY}"
cat "${SUMMARY}"
exit "${EXIT_STATUS}"
