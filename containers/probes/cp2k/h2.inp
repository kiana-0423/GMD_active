! GMD_active CP2K labeling probe: H2 single point (native Quickstep, no ML-SCF).
! Ported from PHAL containers/scripts/validate_cp2k_ml.py h2_input() at 96263b6.
! Basis/potential files are resolved through CP2K's data directory.
&GLOBAL
  PROJECT gmd_al_cp2k_probe_h2
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL
    &SCF
      EPS_SCF 1.0E-6
      MAX_SCF 50
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 10.0 10.0 10.0
    &END CELL
    &COORD
      H 5.0 5.0 4.63
      H 5.0 5.0 5.37
    &END COORD
    &KIND H
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-PBE-q1
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
