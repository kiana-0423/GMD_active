# GMD integration probe: single-point ("0-step") evaluation.
# GMD rejects `run 0` ("run must be greater than zero"), so this runs one step
# and the validator gates on the step-0 row of output.log, which is the energy
# of the initial configuration before any integration (LAMMPS `run 0`).
run 1
time_step 0.1
velocity 1.0
velocity_init random
velocity_seed 20251103
output_interval 1
force_field ml
model_path sgt-probe.pt
ml_jit_optimize off
status_file status.json
run_id gmd-probe-run0
