# syntax=docker/dockerfile:1.7
# Ported from PHAL (containers/Dockerfile.md-probe) at 96263b6; MIT License, see NOTICE.
#
# GMD MD-role image: the GMD C++ engine built with -DGMD_ENABLE_TORCH=ON against
# the LibTorch that ships inside the NGC PyTorch wheel, plus GMD_SGT (used to
# export the random integration-probe model). Replaces PHAL's LAMMPS +
# pair_allegro md-probe and the empty Milestone-1 md scaffold.
#
# Build through containers/build.sh, which resolves every ARG from
# containers/versions.yaml and supplies two named build contexts:
#   gmd_src      `git archive` of the pinned GMD commit (or a git URL#commit)
#   gmd_sgt_src  `git archive` of the pinned GMD_SGT commit (or a git URL#commit)
# The primary build context is the repository root; BuildKit reads
# containers/Dockerfile.gmd.dockerignore for it.
#
# Status: NOT BUILT, NOT VALIDATED (see versions.yaml stacks.gmd.status).

ARG BASE_IMAGE

# =============================================================================
# Stage: builder - compile gmd; discarded
# =============================================================================
FROM ${BASE_IMAGE} AS builder

ARG GMD_COMMIT
ARG GMD_CMAKE_VERSION
ARG GMD_BUILD_JOBS=4

ENV DEBIAN_FRONTEND=noninteractive

RUN test -n "${GMD_COMMIT}" \
    && test -n "${GMD_CMAKE_VERSION}" \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        cmake \
        g++ \
        make \
        ninja-build \
    && rm -rf /var/lib/apt/lists/*

COPY --from=gmd_src . /opt/src/gmd

# build.sh writes .gmd_al_source_commit into the git archive; a git URL context
# is pinned by BuildKit itself and carries no marker.
RUN cd /opt/src/gmd \
    && if [ -f .gmd_al_source_commit ]; then \
           test "$(cat .gmd_al_source_commit)" = "${GMD_COMMIT}"; \
       fi \
    && grep -q "project(GMD VERSION ${GMD_CMAKE_VERSION}" CMakeLists.txt

# LibTorch comes from the base image's PyTorch wheel (CXX11 ABI); installing a
# second LibTorch would split GMD from the torch that exports GMD_SGT models.
RUN cmake \
        -S /opt/src/gmd \
        -B /opt/src/gmd/build \
        -G Ninja \
        -D CMAKE_BUILD_TYPE=Release \
        -D BUILD_TESTING=OFF \
        -D GMD_ENABLE_TORCH=ON \
        -D GMD_ENABLE_MPI=OFF \
        -D GMD_ENABLE_CUDA=OFF \
        -D CMAKE_PREFIX_PATH="$(python -c 'import torch.utils; print(torch.utils.cmake_prefix_path)')" \
    && cmake --build /opt/src/gmd/build --target gmd --parallel "${GMD_BUILD_JOBS}" \
    && install -D -m 0755 /opt/src/gmd/build/gmd /opt/gmd/bin/gmd \
    && printf '%s\n' "${GMD_COMMIT}" > /opt/gmd/GMD_COMMIT

# =============================================================================
# Stage: runtime - gmd + GMD_SGT + validators + probe model
# =============================================================================
FROM ${BASE_IMAGE} AS runtime

ARG BASE_IMAGE
ARG IMAGE_TAG
ARG GMD_VERSION
ARG GMD_COMMIT
ARG GMD_SGT_VERSION
ARG GMD_SGT_COMMIT
ARG E3NN_VERSION
ARG ASE_VERSION
ARG PYYAML_VERSION

LABEL org.opencontainers.image.title="GMD_active GMD MD image" \
      org.opencontainers.image.description="GMD (GMD_ENABLE_TORCH=ON) + GMD_SGT on NGC PyTorch for linux/arm64" \
      org.opencontainers.image.version="${IMAGE_TAG}" \
      org.opencontainers.image.source="containers/Dockerfile.gmd" \
      org.opencontainers.image.base.name="${BASE_IMAGE}" \
      org.gmd-al.versions-file="containers/versions.yaml" \
      org.gmd-al.role="md" \
      org.gmd-al.gmd-version="${GMD_VERSION}" \
      org.gmd-al.gmd-commit="${GMD_COMMIT}" \
      org.gmd-al.gmd-sgt-version="${GMD_SGT_VERSION}" \
      org.gmd-al.gmd-sgt-commit="${GMD_SGT_COMMIT}"

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    GMD_AL_HOME=/opt/gmd_al \
    GMD_AL_RUNTIME_DIR=/runtime \
    GMD_AL_PROBE_DIR=/opt/gmd_al/probes/gmd \
    GMD_HOME=/opt/gmd \
    LD_LIBRARY_PATH=/usr/local/lib/python3.12/dist-packages/torch/lib:/usr/local/cuda/lib64

RUN test -n "${GMD_SGT_VERSION}" \
    && test -n "${GMD_SGT_COMMIT}" \
    && test -n "${E3NN_VERSION}" \
    && test -n "${ASE_VERSION}" \
    && test -n "${PYYAML_VERSION}" \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        binutils \
        ca-certificates \
        file \
    && rm -rf /var/lib/apt/lists/*

# Torch, CUDA and NumPy are inherited from the base image; GMD_SGT is installed
# with --no-deps so pip cannot replace them.
RUN python -m pip install \
        "e3nn==${E3NN_VERSION}" \
        "ase==${ASE_VERSION}" \
        "PyYAML==${PYYAML_VERSION}"

COPY --from=gmd_sgt_src . /opt/src/gmd_sgt
RUN cd /opt/src/gmd_sgt \
    && if [ -f .gmd_al_source_commit ]; then \
           test "$(cat .gmd_al_source_commit)" = "${GMD_SGT_COMMIT}"; \
       fi \
    && python -m pip install --no-deps /opt/src/gmd_sgt \
    && python -c "import gmd_sgt, sys; sys.exit(gmd_sgt.__version__ != '${GMD_SGT_VERSION}')" \
    && rm -rf /opt/src/gmd_sgt

COPY --from=builder /opt/gmd /opt/gmd
RUN ln -s /opt/gmd/bin/gmd /usr/local/bin/gmd \
    && test "$(cat /opt/gmd/GMD_COMMIT)" = "${GMD_COMMIT}"

WORKDIR /opt/gmd_al

COPY containers/scripts/validate_platform.py /opt/gmd_al/containers/scripts/validate_platform.py
COPY containers/scripts/validate_sgt_stack.py /opt/gmd_al/containers/scripts/validate_sgt_stack.py
COPY containers/scripts/build_gmd_probe_model.py /opt/gmd_al/containers/scripts/build_gmd_probe_model.py
COPY containers/scripts/validate_gmd_stack.py /opt/gmd_al/containers/scripts/validate_gmd_stack.py
COPY containers/probes/gmd /opt/gmd_al/probes/gmd

# The probe model is random (training_steps = 0) and scientifically invalid; it
# only proves that a GMD_SGT TorchScript export loads and runs in this GMD.
# gmd itself is checked statically: build hosts usually have no libcuda.so.1,
# which the NGC LibTorch links, so gmd is executed only under `apptainer --nv`.
RUN mkdir -p /runtime/models /runtime/md /runtime/logs \
    && python /opt/gmd_al/containers/scripts/build_gmd_probe_model.py \
        --output "${GMD_AL_PROBE_DIR}/sgt-probe.pt" \
    && python /opt/gmd_al/containers/scripts/validate_gmd_stack.py --mode static

CMD ["python", "/opt/gmd_al/containers/scripts/validate_gmd_stack.py", "--mode", "static"]
