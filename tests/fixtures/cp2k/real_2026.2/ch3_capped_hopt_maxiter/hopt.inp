&GLOBAL
  PROJECT hopt
  RUN_TYPE GEO_OPT
  PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    CHARGE 0
    MULTIPLICITY 1
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 150.0
      REL_CUTOFF 40.0
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
    &END QS
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER WAVELET
    &END POISSON
    &SCF
      MAX_SCF 30
      EPS_SCF 1e-05
      SCF_GUESS ATOMIC
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_SINGLE_INVERSE
      &END OT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL

    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A 13.76253952 0.00000000 0.00000000
      B 0.00000000 13.76253952 0.00000000
      C 0.00000000 0.00000000 13.76253952
      PERIODIC NONE
    &END CELL
    &COORD
    C        6.62686909       6.88126976       6.53158029
    H        7.64447176       6.88126976       6.14095923
    H        6.11806776       7.76253952       6.14095923
    H        6.11806776       6.00000000       6.14095923
    H        6.62686909       6.88126976       7.62158029
    &END COORD
    &KIND C
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE
    &END KIND
    &KIND H
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE
    &END KIND
  &END SUBSYS
  &PRINT
    &FORCES MEDIUM
    &END FORCES
  &END PRINT
&END FORCE_EVAL
&MOTION
  &GEO_OPT
    OPTIMIZER BFGS
    MAX_ITER 1
  &END GEO_OPT
  &CONSTRAINT
    &FIXED_ATOMS
      COMPONENTS_TO_FIX XYZ
      LIST 1 2 3 4
    &END FIXED_ATOMS
  &END CONSTRAINT
&END MOTION
