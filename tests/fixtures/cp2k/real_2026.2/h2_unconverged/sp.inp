&GLOBAL
  PROJECT sp
  RUN_TYPE ENERGY_FORCE
  PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    CHARGE 0
    MULTIPLICITY 1
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 150.0
      REL_CUTOFF 40.0
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
    &END QS
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER WAVELET
    &END POISSON
    &SCF
      MAX_SCF 2
      EPS_SCF 1e-05
      SCF_GUESS ATOMIC
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_SINGLE_INVERSE
      &END OT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL

    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A 12.74000000 0.00000000 0.00000000
      B 0.00000000 12.74000000 0.00000000
      C 0.00000000 0.00000000 12.74000000
      PERIODIC NONE
    &END CELL
    &COORD
    H        6.00000000       6.37000000       6.37000000
    H        6.74000000       6.37000000       6.37000000
    &END COORD
    &KIND H
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE
    &END KIND
  &END SUBSYS
  &PRINT
    &FORCES MEDIUM
    &END FORCES
  &END PRINT
&END FORCE_EVAL

