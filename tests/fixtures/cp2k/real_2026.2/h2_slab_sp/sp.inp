&GLOBAL
  PROJECT sp
  RUN_TYPE ENERGY_FORCE
  PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    CHARGE 0
    MULTIPLICITY 1
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 150.0
      REL_CUTOFF 40.0
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
    &END QS
    &POISSON
      PERIODIC XY
      POISSON_SOLVER MT
    &END POISSON
    &SCF
      MAX_SCF 30
      EPS_SCF 1e-05
      SCF_GUESS ATOMIC
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_SINGLE_INVERSE
      &END OT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL

    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A 5.00000000 0.00000000 0.00000000
      B 0.00000000 5.00000000 0.00000000
      C 0.00000000 0.00000000 10.00000000
      PERIODIC XY
    &END CELL
    &COORD
    H        2.13000000       2.50000000       5.00000000
    H        2.87000000       2.50000000       5.00000000
    &END COORD
    &KIND H
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE
    &END KIND
  &END SUBSYS
  &PRINT
    &FORCES MEDIUM
    &END FORCES
  &END PRINT
&END FORCE_EVAL

