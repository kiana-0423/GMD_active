! CP2K input template for Pulay-matrix dataset generation: metals and
! transition-metal oxides.
!
! Same contract as pulay_dataset.inp.template (see it first). What differs is
! the SCF block: a small-cell oxide at the Gamma point has states at the Fermi
! level, and without smearing plus empty states the SCF does not converge --
! the sample would be rejected for non-convergence rather than for anything
! chemical. MAX_SCF is higher for the same reason.
!
! Smearing changes the occupations, not the mixing: CP2K still builds the same
! Pulay matrix from the same g-space residuals, which is what this dataset is
! collecting.

&GLOBAL
  PROJECT {{PROJECT}}
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL
    &SCF
      EPS_SCF 1.0E-6
      MAX_SCF 120
      ADDED_MOS 60
      &SMEAR ON
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE 500
      &END SMEAR
      &MIXING
        METHOD PULAY_MIXING
        ALPHA 0.4
        NBUFFER 8
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &MGRID
      CUTOFF 400
      REL_CUTOFF 50
    &END MGRID
    &PRINT
      &AO_MATRICES
        DENSITY .TRUE.
        OVERLAP .TRUE.
        NDIGITS 12
      &END AO_MATRICES
    &END PRINT
  &END DFT
  &SUBSYS
    &CELL
{{CELL}}
    &END CELL
    &COORD
{{COORD}}
    &END COORD
{{KIND}}
  &END SUBSYS
&END FORCE_EVAL
